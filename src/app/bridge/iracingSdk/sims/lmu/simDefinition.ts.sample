// NOT COMPILED. Rename to `simDefinition.ts` to register Le Mans Ultimate.
//
// The registry discovers sources with `import.meta.glob('./*/simDefinition.ts')`
// (see ../registry.ts), which this extension deliberately does not match — so
// the file ships alongside the auto-detect work without pulling LMU into the
// build. TypeScript and ESLint only visit `.ts`/`.tsx`, so it is free to import
// the native module and bridge below, neither of which exists yet.
//
// Renaming it is the whole of "register LMU", and requires the shared-memory
// bridge and native addon from the LMU pull request (#747) to be present:
//   - src/app/bridge/iracingSdk/lmuSdkBridge.ts
//   - src/app/irsdk/native/lmu/  (plus the lmu_node target in binding.gyp)
// Without them the registry would still list LMU, and `createProbe` would throw
// and log per probe rather than taking detection down — but it would never
// select. `registry.spec.ts` asserts LMU reads as unavailable while this file
// stays a sample.

import type { SimDefinition, SimProbe } from '../types';

/**
 * Le Mans Ultimate, read through its shared-memory map.
 *
 * Priority sits below iRacing's 100, so iRacing takes any tie: with both sims
 * reading as active at once, the one this app was built around is the safer
 * guess at which the driver is actually sitting in.
 */
const lmu: SimDefinition = {
  id: 'lmu',
  priority: 90,

  createProbe: async (): Promise<SimProbe> => {
    const { NativeLmu } = await import('../../../../irsdk/native/lmu');
    const sdk = new NativeLmu();
    return {
      start: () => sdk.start(),
      isActive: () => {
        const frame = sdk.read();
        return (
          frame.running && frame.trackName.length > 0 && frame.numVehicles > 0
        );
      },
      stop: () => sdk.stop(),
    };
  },

  loadBridge: async () => {
    const { publishLmuSDKEvents } = await import('../../lmuSdkBridge');
    return publishLmuSDKEvents;
  },
};

export default lmu;
