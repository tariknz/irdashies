{
  "name": "irdashies",
  "productName": "irdashies",
  "version": "0.9.0",
  "description": "iRacing Dashboards & Overlays",
  "repository": {
    "type": "git",
    "url": "https://github.com/tariknz/irdashies"
  },
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start --enable-logging",
    "generate-assets": "npx tsx ./tools/index.ts",
    "generate-track-json": "npx tsx ./tools/generate-track-json.ts",
    "irsdk:build": "node-gyp rebuild",
    "irsdk:fixture": "build\\Release\\irsdk_replay.exe fixture",
    "irsdk:inspect": "build\\Release\\irsdk_replay.exe inspect",
    "irsdk:record": "build\\Release\\irsdk_replay.exe record",
    "irsdk:replay": "build\\Release\\irsdk_replay.exe play",
    "irsdk:replay:curated": "build\\Release\\irsdk_replay.exe play --input test-data\\telemetry\\ai-race-10min.irdt",
    "irsdk:replay:app": "node tools/run-telemetry-replay.mjs",
    "irsdk:replay:app:curated": "node tools/run-telemetry-replay.mjs --input test-data/telemetry/ai-race-10min.irdt --loop",
    "test:replay:curated": "tsx tools/telemetry-replay/run-curated-validation.ts",
    "test:replay:curated:update": "npm run test:replay:curated -- --update",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish:ci": "electron-forge publish",
    "publish": "npx env-cmd electron-forge publish",
    "lint": "tsc --project ./tsconfig.json --noEmit && eslint . --max-warnings 0",
    "site": "vite --config site/vite.config.ts site",
    "site:build": "vite build --config site/vite.config.ts site",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --coverage",
    "perf:run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/perf/run.ts",
    "perf:analyze": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/perf/analyze.ts",
    "ensure-tracks": "npx tsx ./tools/ensure-tracks.ts",
    "fetch-lovely-data": "npx tsx ./tools/fetch-lovely-data.ts",
    "fetch-lovely-track-data": "npx tsx ./tools/fetch-lovely-track-data.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "electron": "^43.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.5.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "node-addon-api": "^8.9.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "storybook": "^10.5.5",
    "svg-path-properties": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "terser": "^5.49.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "keywords": [],
  "author": {
    "name": "Tarik Alani",
    "email": "tarik.nzl@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tmi.js/chat": "^0.8.0",
    "d3": "^7.9.0",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "flag-icons": "^7.5.0",
    "js-yaml": "^5.2.3",
    "posthog-node": "^5.47.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "update-electron-app": "^3.3.0",
    "ws": "^8.21.1",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "yauzl": "^3.3.1",
    "@electron/rebuild": "^4"
  }
}
